# ── ContentOps 平台（crew 的工具来源 + 回写目标）──────────────────────────────
CONTENTOPS_BASE_URL=http://host.docker.internal:8080
CONTENTOPS_USERNAME=crew_service
CONTENTOPS_PASSWORD=change-me-12345

# ── 模型（OpenAI 兼容端点；与后端 model-routing 可用同一把 Key）──────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.4

# ── 执行器：auto（有 crewai 就用 crewai，否则用内置精简执行器）/ crewai / lite ──
CREW_EXECUTOR=auto

# ── 单次研究参数 ────────────────────────────────────────────────────────────
CREW_MAX_TOPICS=3
CREW_REQUEST_TIMEOUT=180
CREW_PORT=8000
