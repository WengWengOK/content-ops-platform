# 复制为 alerts.env 并填入真实 Webhook 后，运行 scripts/start-backend.ps1 即可生效
# 飞书群机器人 Webhook（群设置 → 群机器人 → 添加机器人 → 自定义机器人）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的token
# 企业微信群机器人 Webhook（群聊 → 添加群机器人 → 复制地址）
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
# 模型 Key（可选，缺省用 application.yml 默认值）
OPENAI_API_KEY=sk-your-openai-compatible-key
