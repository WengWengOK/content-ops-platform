<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.contentops</groupId>
        <artifactId>content-ops-agent-platform-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../content-ops-configs/pom.xml</relativePath>
    </parent>

    <artifactId>content-ops-orchestrator</artifactId>
    <name>Content Ops Orchestrator Service</name>
    <description>Phase3 编排器服务（端口 8080）：状态机 + 控制面 + API 网关。
        第一阶段（渐进拆分）：直接依赖 legacy content-ops-server 模块把编排器 + 全量 Agent + Tool 一并加载，
        保证拆分期间功能 100% 等价于单体；后续再逐包迁到 worker/tools。</description>

    <dependencies>
        <!-- 公共契约 -->
        <dependency>
            <groupId>com.contentops</groupId>
            <artifactId>content-ops-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 渐进拆分策略：直接复用 legacy-server 的全部代码，避免一次性搬代码的大规模回归风险 -->
        <dependency>
            <groupId>com.contentops</groupId>
            <artifactId>content-ops-server</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
