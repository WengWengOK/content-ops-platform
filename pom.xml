<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      根聚合 POM：仅用于把 content-ops-configs（父 POM）纳入 reactor，
      让 IDE（IntelliJ 等）直接打开仓库根目录即可识别 Maven 工程，
      并支持从根目录执行：
        mvn -pl :content-ops-server spring-boot:run
      真正的父 POM（依赖管理与模块声明）在 content-ops-configs/pom.xml。
    -->
    <groupId>com.contentops</groupId>
    <artifactId>content-ops-workspace</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Content Ops Agent Platform (Workspace)</name>
    <description>根聚合 POM — 便于 IDE 导入与命令行从根目录构建</description>

    <modules>
        <module>content-ops-configs</module>
    </modules></project>
